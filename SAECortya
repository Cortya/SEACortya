local DRAG_THRESHOLD = 6
local CLICK_MAX_TIME = 0.25

local function makeClickOrDrag(frame: GuiObject, onClick: () -> ())
	local dragging = false
	local dragStartMouse: Vector2? = nil
	local dragStartFramePos: UDim2? = nil
	local pressTime = 0
	local moved = false
	local inputChangedConn: RBXScriptConnection? = nil
	local inputEndedConn: RBXScriptConnection? = nil

	local function stopTracking()
		if inputChangedConn then inputChangedConn:Disconnect() inputChangedConn = nil end
		if inputEndedConn then inputEndedConn:Disconnect() inputEndedConn = nil end
		dragging = false
		dragStartMouse = nil
		dragStartFramePos = nil
		moved = false
	end

	frame.InputBegan:Connect(function(input)
		if input.UserInputType ~= Enum.UserInputType.MouseButton1
			and input.UserInputType ~= Enum.UserInputType.Touch then
			return
		end

		dragging = true
		moved = false
		pressTime = os.clock()
		dragStartMouse = Vector2.new(input.Position.X, input.Position.Y)
		dragStartFramePos = frame.Position

		inputChangedConn = UserInputService.InputChanged:Connect(function(moveInput)
			if not dragging then return end
			if moveInput.UserInputType ~= Enum.UserInputType.MouseMovement
				and moveInput.UserInputType ~= Enum.UserInputType.Touch then
				return
			end
			if not dragStartMouse or not dragStartFramePos then return end

			local curMouse = Vector2.new(moveInput.Position.X, moveInput.Position.Y)
			local delta = curMouse - dragStartMouse

			if math.abs(delta.X) > DRAG_THRESHOLD or math.abs(delta.Y) > DRAG_THRESHOLD then
				moved = true
			end

			frame.Position = UDim2.new(
				dragStartFramePos.X.Scale,
				dragStartFramePos.X.Offset + delta.X,
				dragStartFramePos.Y.Scale,
				dragStartFramePos.Y.Offset + delta.Y
			)
		end)

		inputEndedConn = UserInputService.InputEnded:Connect(function(endInput)
			if endInput.UserInputType ~= Enum.UserInputType.MouseButton1
				and endInput.UserInputType ~= Enum.UserInputType.Touch then
				return
			end

			local elapsed = os.clock() - pressTime
			local wasClick = (not moved) and elapsed <= CLICK_MAX_TIME

			stopTracking()

			if wasClick then
				onClick()
			end
		end)
	end)
end

