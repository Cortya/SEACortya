local function setProximityRange(value)
	proximityRange = value
	for _, obj in ipairs(workspace:GetDescendants()) do
		if obj:IsA("ProximityPrompt") then
			obj.MaxActivationDistance = value
		end
	end
end

local connection
local snappyEnabled = false

local function setupCharacter(character)
	if connection then
		connection:Disconnect()
		connection = nil
	end

	local humanoid = character:WaitForChild("Humanoid")
	local root = character:WaitForChild("HumanoidRootPart")

	if not snappyEnabled then return end

	connection = RunService.Heartbeat:Connect(function()
		if not character.Parent or humanoid.Health <= 0 then return end

		local velocity = root.AssemblyLinearVelocity
		local move = humanoid.MoveDirection
		local horizontal = Vector3.new(velocity.X, 0, velocity.Z)

		if move.Magnitude > 0.01 then
			local speed = horizontal.Magnitude
			if speed > 0.05 then
				local dir = move.Unit
				root.AssemblyLinearVelocity = Vector3.new(dir.X * speed, velocity.Y, dir.Z * speed)
			end
		else
			root.AssemblyLinearVelocity = Vector3.new(0, velocity.Y, 0)
		end
	end)
end

local function setSnappy(state)
	snappyEnabled = state
	if snappyEnabled then
		if player.Character then setupCharacter(player.Character) end
	else
		if connection then
			connection:Disconnect()
			connection = nil
		end
	end
end

