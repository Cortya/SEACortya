local function setToggleVisual(state: boolean, refs, skipAnimation: boolean?)
	local info = skipAnimation and TweenInfo.new(0) or SWITCH_TWEEN
	local cinfo = skipAnimation and TweenInfo.new(0) or COLOR_TWEEN

	if state then
		TweenService:Create(refs.knob, info, {
			Position = UDim2.new(0, KNOB_ON_X, 0, KNOB_PAD),
		}):Play()
		TweenService:Create(refs.knobShadow, info, {
			Position = UDim2.new(0, KNOB_ON_X, 0, KNOB_PAD + 1),
		}):Play()
		TweenService:Create(refs.track, cinfo, { BackgroundColor3 = GREEN }):Play()
		TweenService:Create(refs.trackStroke, cinfo, { Color = GREEN_DARK }):Play()
		TweenService:Create(refs.stroke, cinfo, { Color = ACCENT, Transparency = 0.05 }):Play()
		TweenService:Create(refs.label, cinfo, { TextColor3 = ACCENT }):Play()
	else
		TweenService:Create(refs.knob, info, {
			Position = UDim2.new(0, KNOB_PAD, 0, KNOB_PAD),
		}):Play()
		TweenService:Create(refs.knobShadow, info, {
			Position = UDim2.new(0, KNOB_PAD, 0, KNOB_PAD + 1),
		}):Play()
		TweenService:Create(refs.track, cinfo, { BackgroundColor3 = TRACK_OFF }):Play()
		TweenService:Create(refs.trackStroke, cinfo, { Color = TRACK_OFF_D }):Play()
		TweenService:Create(refs.stroke, cinfo, { Color = BORDER_SOFT, Transparency = 0.1 }):Play()
		TweenService:Create(refs.label, cinfo, { TextColor3 = TEXT_MAIN }):Play()
	end
end

