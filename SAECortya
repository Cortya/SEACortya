local fadeTargets: {Instance} = {}
local fadeOriginal: {[Instance]: {[string]: any}} = {}

local function captureFadeState(inst: Instance)
	if fadeOriginal[inst] then return end

	local snap = {}
	if inst:IsA("TextLabel") or inst:IsA("TextButton") then
		snap.TextTransparency = inst.TextTransparency
		snap.BackgroundTransparency = inst.BackgroundTransparency
	elseif inst:IsA("Frame") then
		snap.BackgroundTransparency = inst.BackgroundTransparency
	elseif inst:IsA("ImageLabel") or inst:IsA("ImageButton") then
		snap.ImageTransparency = inst.ImageTransparency
		snap.BackgroundTransparency = inst.BackgroundTransparency
	elseif inst:IsA("UIStroke") then
		snap.Transparency = inst.Transparency
	end
	fadeOriginal[inst] = snap
	table.insert(fadeTargets, inst)
end

local function registerContent(inst: Instance)
	for _, d in ipairs(inst:GetDescendants()) do
		captureFadeState(d)
	end
	captureFadeState(inst)
end

local function fadeTo(target: number)
	for _, obj in ipairs(fadeTargets) do
		if not obj.Parent then continue end
		local orig = fadeOriginal[obj]
		if not orig then continue end

		local props: {[string]: any} = {}
		for key, value in pairs(orig) do
			if type(value) == "number" then
				props[key] = target
			end
		end
		if next(props) then
			TweenService:Create(obj, FADE_TWEEN, props):Play()
		end
	end
end

local function fadeBack()
	for _, obj in ipairs(fadeTargets) do
		if not obj.Parent then continue end
		local orig = fadeOriginal[obj]
		if not orig then continue end

		local props: {[string]: any} = {}
		for key, value in pairs(orig) do
			if type(value) == "number" then
				props[key] = value
			end
		end
		if next(props) then
			TweenService:Create(obj, FADE_TWEEN, props):Play()
		end
	end
end

