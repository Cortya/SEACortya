topBar.InputBegan:Connect(function(input)
	if input.UserInputType ~= Enum.UserInputType.MouseButton1
		and input.UserInputType ~= Enum.UserInputType.Touch then
		return
	end
	frameDragging = true
	frameDragStartMouse = Vector2.new(input.Position.X, input.Position.Y)
	frameDragStartPos = mainFrame.Position
end)

UserInputService.InputChanged:Connect(function(input)
	if not frameDragging then return end
	if input.UserInputType ~= Enum.UserInputType.MouseMovement
		and input.UserInputType ~= Enum.UserInputType.Touch then
		return
	end
	if not frameDragStartMouse or not frameDragStartPos then return end

	local cur = Vector2.new(input.Position.X, input.Position.Y)
	local delta = cur - frameDragStartMouse

	mainFrame.Position = UDim2.new(
		frameDragStartPos.X.Scale,
		frameDragStartPos.X.Offset + delta.X,
		frameDragStartPos.Y.Scale,
		frameDragStartPos.Y.Offset + delta.Y
	)
end)

UserInputService.InputEnded:Connect(function(input)
	if input.UserInputType ~= Enum.UserInputType.MouseButton1
		and input.UserInputType ~= Enum.UserInputType.Touch then
		return
	end
	frameDragging = false
	frameDragStartMouse = nil
	frameDragStartPos = nil
end)

local collapsed = true
local animating = false

local function collapseGui()
	if animating or collapsed then return end
	animating = true
	collapsed = true

	floatingNut.Position = UDim2.new(
		0,
		mainFrame.AbsolutePosition.X + mainFrame.AbsoluteSize.X / 2,
		0,
		mainFrame.AbsolutePosition.Y + mainFrame.AbsoluteSize.Y / 2
	)
	floatingNut.Size = UDim2.new(0, 0, 0, 0)
	floatingNut.Visible = true

	fadeTo(1)

	task.wait(FADE_TWEEN.Time)

	local t = TweenService:Create(mainFrame, COLLAPSE_TWEEN, {
		Size = UDim2.new(0, 0, 0, 0),
		BackgroundTransparency = 1,
	})
	t:Play()

	TweenService:Create(mainStroke, COLLAPSE_TWEEN, { Transparency = 1 }):Play()

	task.wait(COLLAPSE_TWEEN.Time)

	mainFrame.Visible = false
	mainStroke.Transparency = 0
	mainFrame.BackgroundTransparency = 0

	local grow = TweenService:Create(floatingNut, TweenInfo.new(0.34, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
		Size = UDim2.new(0, 72, 0, 72),
	})
	grow:Play()
	grow.Completed:Wait()

	animating = false
end

local function expandGui()
	if animating or not collapsed then return end
	animating = true
	collapsed = false

	local shrink = TweenService:Create(floatingNut, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Size = UDim2.new(0, 0, 0, 0),
	})
	shrink:Play()
	shrink.Completed:Wait()
	floatingNut.Visible = false

	mainFrame.Position = floatingNut.Position
	mainFrame.Visible = true
	mainFrame.Size = UDim2.new(0, 0, 0, 0)
	mainFrame.BackgroundTransparency = 1
	mainStroke.Transparency = 1

	local t = TweenService:Create(mainFrame, COLLAPSE_TWEEN, {
		Size = UDim2.new(0, FINAL_W, 0, FINAL_H),
		BackgroundTransparency = 0,
	})
	t:Play()

	TweenService:Create(mainStroke, COLLAPSE_TWEEN, { Transparency = 0 }):Play()

	task.delay(COLLAPSE_TWEEN.Time * 0.4, function()
		fadeBack()
	end)

	t.Completed:Wait()

	animating = false
end

