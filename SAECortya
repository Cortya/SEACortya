local HITBOX_NAME = "Hitbox"

local function isInsidePlayerTrap(inst: Instance): boolean
	local current: Instance? = inst
	while current do
		if current.Name == TRAP_NAME then return true end
		current = current.Parent
	end
	return false
end

local function nukeHitboxesIn(root: Instance): number
	local removed = 0
	for _, obj in ipairs(root:GetDescendants()) do
		if obj:IsA("BasePart") and obj.Name == HITBOX_NAME and isInsidePlayerTrap(obj) then
			obj:Destroy()
			removed += 1
		end
	end
	return removed
end

local function nukeAllHitboxes(): number
	local removed = 0
	for _, obj in ipairs(workspace:GetDescendants()) do
		if obj:IsA("BasePart") and obj.Name == HITBOX_NAME and isInsidePlayerTrap(obj) then
			obj:Destroy()
			removed += 1
		end
	end
	return removed
end

local hitboxCleanerEnabled = false
local cleanerConnection: RBXScriptConnection? = nil

local function startHitboxCleaner()
	if cleanerConnection then
		cleanerConnection:Disconnect()
		cleanerConnection = nil
	end

	nukeAllHitboxes()

	cleanerConnection = workspace.DescendantAdded:Connect(function(obj)
		if not hitboxCleanerEnabled then return end

		if obj:IsA("BasePart") and obj.Name == HITBOX_NAME then
			if isInsidePlayerTrap(obj) then
				obj:Destroy()
			end
			return
		end

		if obj.Name == TRAP_NAME then
			nukeHitboxesIn(obj)
			return
		end

		if #obj:GetChildren() > 0 then
			nukeHitboxesIn(obj)
		end
	end)
end

local function stopHitboxCleaner()
	if cleanerConnection then
		cleanerConnection:Disconnect()
		cleanerConnection = nil
	end
end

local function setHitboxCleaner(state: boolean)
	hitboxCleanerEnabled = state
	if state then
		startHitboxCleaner()
	else
		stopHitboxCleaner()
	end
end

