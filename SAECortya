local TRAP_NAME = "PlayerTrap"
local HIGHLIGHT_NAME = "CortyaTrapHighlight"

local trapESPEnabled = false
local trackedTraps: {[Instance]: Highlight} = {}

local function attachHighlight(part: BasePart)
	if trackedTraps[part] then return end

	local hl = Instance.new("Highlight")
	hl.Name = HIGHLIGHT_NAME
	hl.Adornee = part
	hl.FillColor = ACCENT
	hl.OutlineColor = ACCENT_LIGHT
	hl.FillTransparency = 0.5
	hl.OutlineTransparency = 0.05
	hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	hl.Parent = part

	trackedTraps[part] = hl

	part.AncestryChanged:Connect(function()
		if not part:IsDescendantOf(game) then
			local existing = trackedTraps[part]
			if existing then
				existing:Destroy()
				trackedTraps[part] = nil
			end
		end
	end)
end

local function detachAllHighlights()
	for part, hl in pairs(trackedTraps) do
		hl:Destroy()
		trackedTraps[part] = nil
	end
end

local function scanAndAttach()
	for _, obj in ipairs(workspace:GetDescendants()) do
		if obj:IsA("BasePart") and obj.Name == TRAP_NAME then
			attachHighlight(obj)
		end
	end
end

workspace.DescendantAdded:Connect(function(obj)
	if not trapESPEnabled then return end
	if obj:IsA("BasePart") and obj.Name == TRAP_NAME then
		attachHighlight(obj)
	end
end)

local function setTrapESP(state: boolean)
	trapESPEnabled = state

	if state then
		scanAndAttach()
	else
		detachAllHighlights()
	end
end

